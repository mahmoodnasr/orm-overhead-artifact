# Copy to .env, edit the credentials/targets, then: set -a; . ./.env; set +a
# Example values only. Both frameworks must point at the same dataset.
TPCH_SF=1
DJANGO_SETTINGS_MODULE=django_app.settings
DJ_VENDOR=postgresql
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=tpch
POSTGRES_USER=benchmark
POSTGRES_PASSWORD=replace-me
PG_DSN='host=127.0.0.1 port=5432 dbname=tpch user=benchmark password=replace-me'
SA_DSN='postgresql+psycopg2://benchmark:replace-me@127.0.0.1:5432/tpch'

# Set for the system under test. URL-encode special characters in SA_DSN.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=tpch
MYSQL_USER=benchmark
MYSQL_PASSWORD=replace-me
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=tpch
ORACLE_PASSWORD=replace-me
SQLSERVER_HOST=127.0.0.1
SQLSERVER_PORT=1433
SQLSERVER_DB=tpch
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=replace-me
SQLSERVER_SA_PASSWORD=replace-me

QUERY_TIMEOUT=900
VALIDATE_TIMEOUT=900
BENCH_CLIENT_CPUS=2,3
CAMPAIGN_ID=sf1-review-rerun
