 "design": {
  "paths": [
   "django/sql",
   "django/orm",
   "sqlalchemy/sql",
   "sqlalchemy/orm"
  ],
  "williams": [
   [
    "django/sql",
    "django/orm",
    "sqlalchemy/sql",
    "sqlalchemy/orm"
   ],
   [
    "django/orm",
    "sqlalchemy/orm",
    "django/sql",
    "sqlalchemy/sql"
   ],
   [
    "sqlalchemy/orm",
    "sqlalchemy/sql",
    "django/orm",
    "django/sql"
   ],
   [
    "sqlalchemy/sql",
    "django/sql",
    "sqlalchemy/orm",
    "django/orm"
   ]
  ],
  "blocks": 8,
  "block_plan": "two seeded permutations of the four Williams sequences; seed = first 64 bits of sha256(\"<protocol_id>:<dbms>:<schema>:sf<scale>:<database_label>:q<n>\")",
  "cell_warmup": "one sequence (Williams seed mod 4) on the ninth parameter instance; recorded, never timed",
  "block_warmup": "each non-skipped path once on the block parameters before the timed sequence; recorded",
  "censoring": "a path that times out in the cell warmup is skipped for the cell and recorded as censored_in_cell_warmup on every block; a timed-call timeout is recorded and the next block tries again (historical behaviour)",
  "no_2700s_retry": "Historical campaigns retried a censored cell once at 2700 s. Not repeated here within the main phase; censored cells are handled in phase B with an explicit budget.",
  "phase_E": "Physically separate client (R2-6): the Mac (Apple M4, macOS 27) runs the phase A protocol as client of the benchmark host's databases over the LAN, Wi-Fi at both ends (host wlp3s0 2.4 GHz, power saving off; the host's Ethernet port is down; no wired adapter). Same database host, SF1 data (fingerprints before and after per engine), source snapshot, inputs, index states, server settings and result policy as phase A; runner code/rc_e.py subclasses the phase A runner with --client-mode separate-client.",
  "phase_E_cells": "Q6, Q17, Q18, Q20, Q21 x 4 engines x 2 index states x 2 frameworks, except the five SF1 host-censored query cells (PostgreSQL non-indexed Q17/Q20/Q21, MySQL non-indexed Q17/Q20): 35 query cells, 70 framework cells, 8 blocks each.",
  "phase_E_client": "Pinned client container rcg-client:3.12.3 (Python 3.12.3, the host venv's package versions; linux/arm64; 2 CPUs on VM vCPUs 2-3, 3 GB), as phase G v2; recorded per run with the Mac model and macOS version. The host client in phase A is /usr/bin/python3.12 on x86_64 Ubuntu pinned to CPUs 2-3. E versus A is therefore the combined observed change of network, client machine, OS and architecture, not pure network overhead (brief, part E).",
  "phase_E_host_evidence": "bench-host verify and Oracle process affinity read over ssh immediately before (recorded in the run inventory and gated as in phase A) and after every run; the host must run no other campaign unit.",
  "phase_E_network": "Per run: ping summary (60 x 0.5 s) before and after, a 1 s ping log during the run, the Mac's and the host's Wi-Fi link (PHY mode, channel, rate, signal/noise; no network name or hardware address). Not part of any timing.",
  "phase_E_oracle_cancellation": "Oracle runs only with V$SESSION readable (root helper action oracle-session-view; gated): the /proc fallback of the same-host runner sees no Oracle processes from the client.",
  "phase_E_order": "Per engine: host plan E-<engine>-a, root action, reachability, network cancellation pilot, the separate-client trial (first engine only; must pass before the long run), first index state, host plan E-<engine>-b, second state, host plan E-<engine>-c, undo of the root action. Engines in the order the host leaves them: Oracle, Commercial System A, PostgreSQL, MySQL.",
  "phase_E_driver": "code/rc_e_driver.sh: resumable step markers in E-client/steps; a watchdog kills a client whose progress file has not moved for 25 minutes (a dead socket over Wi-Fi can block past the 900 s statement limit) and the run resumes, up to three attempts; a refused gate, failed end checks or a fatal record stop the driver instead."
 },
 "ceilings": {
  "per_call_s": 900,
  "postgresql": "SET statement_timeout, read back",
  "mysql": "SET SESSION max_execution_time, read back",
  "commercial_a": "pyodbc connection.timeout on both connections, read back",
  "oracle": "oracledb call_timeout on both connections, read back"
 },
 "timer": "time.perf_counter around run_query_sql/run_query_orm, which return the complete materialised list of rows; statement-capture hooks (one list append per statement) are inside the timer for all four paths; typing, hashing, comparison and disk writes are outside.",
 "after_failure": "rollback, close both frameworks connections, poll the server until the old session shows no running request (60 s), kill if needed, re-arm and read back the ceiling; stop the run if stopping cannot be shown.",
 "result_policy": {
  "version": "rc20261008-results-v3",
  "text": "Shared evidence, result-check and record helpers for campaign rc20261008.\n\nNo database dependency. Imported by the analytical runner, the transaction\nrunner, the offline verifier and the analysis, so that a record is written,\nre-read and re-checked by one implementation of each rule.\n\nResult policy (frozen in protocol rc20261008-A-v1 before any execution):\n\n  E1 exact     named columns (canonical names), Python equality of every value,\n               duplicates kept, strict row order. Python equality is exact\n               across int/Decimal/float: Decimal('0.1') != 0.1.\n  E2 date      a naive datetime at 00:00:00 equals the date with the same\n               Y-M-D. Oracle returns DATE columns as datetimes through a raw\n               cursor while the ORM converts them to dates; this is the one\n               value normalisation applied before comparison.\n  E3 ties      rows whose ORDER BY key tuples are equal may legally appear in\n               either order. Accepted as tie_equivalent only when the sequence\n               of key tuples is identical and every run of equal keys is an\n               identical multiset of complete rows. Never sorts inside a row.\n  E4 numeric   a float on one side and an exact number on the other compare as\n               representation-equal only if float(exact) == the float, i.e. the\n               float is the correctly rounded double of the exact value. No\n               tolerance, no rounding. Reported separately.\n  R  review    a LIMIT query whose final run of equal keys differs is\n               limit_boundary_tie; any other difference is mismatch. Neither is\n               accepted by the runner.\n\nAmendment v2 (added 2026-10-08 after pilot P-v1 observed it on Commercial System A Q14,\nbefore any main-phase execution; v1 decisions keep their v1 classification):\n\n  E5 scale    an exact Decimal d whose own scale s has at least 4 fractional\n               digits, against a value x carrying more fractional digits (a\n               float, or a Decimal of larger scale): scale_equivalent if x,\n               expanded exactly and cut to s digits by truncation or by\n               round-half-even, equals d. Observed cause: Commercial System A types\n               100.00 * SUM(..) / SUM(..) as DECIMAL with scale 6 and truncates\n               the quotient (16.380778), while both ORMs bind 100.0 as a float\n               and return 16.3807786263... The rule is exact at the baseline's\n               own declared scale; it never applies to values with fewer than 4\n               fractional digits (money columns must agree exactly), and pairs\n               accepted under it are counted separately.\n\nAmendment v3 (2026-10-08, after the PostgreSQL pilot, before any main-phase\nexecution). Acceptance is unchanged; only rejected pairs are split:\n\n  numeric_mismatch  same row count and order, every non-numeric value and\n               every ORDER BY key identical, and only numeric values differ.\n               Rejected, with the largest relative difference recorded. Seen:\n               SQLAlchemy 2.0 renders `/` on Numeric(15,2) operands as\n               `x / CAST(y AS NUMERIC(15, 2))`, rounding a scale-4 denominator,\n               so Q8 and Q14 differ from the baseline near the 11th digit.\n  mismatch     anything else (rows, keys, strings, counts). Rejected.\n",
  "accepted_classes": [
   "exact",
   "tie_equivalent",
   "numeric_representation",
   "scale_equivalent"
  ],
